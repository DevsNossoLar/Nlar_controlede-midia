# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /repo

COPY package.json package-lock.json turbo.json ./
COPY packages ./packages
COPY apps/docs/package.json ./apps/docs/package.json
COPY apps/web ./apps/web

RUN node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package-lock.json','utf8')); console.log('v',p.lockfileVersion); const ci=require('child_process').spawnSync('npm',['ci','--dry-run'],{encoding:'utf8'}); console.log('status',ci.status); console.log(ci.stdout); console.log(ci.stderr);"
